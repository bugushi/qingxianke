---
interface Props {
	date: Date;
}

const { date } = Astro.props;

const pad = (value: number) => value.toString().padStart(2, '0');
const formattedDate = `${date.getFullYear()}.${pad(date.getMonth() + 1)}.${pad(date.getDate())}`;
---

<time datetime={date.toISOString()}>
	{formattedDate}
</time>
